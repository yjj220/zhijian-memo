<Window x:Class="StickyPad.Views.TaskEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑待办 · 纸间" Width="440" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#FAF9F5" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DADFD8"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <StackPanel Margin="26">
  <TextBlock Text="记下下一件事" FontSize="24" FontWeight="SemiBold" Foreground="#294D40"/>
  <TextBlock Text="给重要的事情，留一个时间。" Foreground="#7D877F" Margin="0,6,0,22"/>
  <TextBlock Text="待办事项" Margin="0,0,0,6"/>
  <TextBox x:Name="TitleInput" MaxLength="200" AutomationProperties.Name="待办事项"/>
  <TextBlock Text="补充说明（可选）" Margin="0,16,0,6"/>
  <TextBox x:Name="DetailsInput" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="补充说明"/>
  <CheckBox x:Name="HasDue" Content="设置截止时间" Margin="0,20,0,10" Checked="DueChanged" Unchecked="DueChanged"/>
  <Grid IsEnabled="{Binding IsChecked, ElementName=HasDue}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
   <DatePicker x:Name="DueDate" SelectedDateFormat="Short" VerticalContentAlignment="Center" AutomationProperties.Name="截止日期"/>
   <TextBox x:Name="DueTime" Grid.Column="1" Margin="10,0,0,0" Text="18:00" MaxLength="5" ToolTip="24 小时制，例如 18:30" AutomationProperties.Name="截止时间"/>
  </Grid>
  <TextBlock Text="提醒时间" Margin="0,16,0,6"/>
  <ComboBox x:Name="ReminderChoice" SelectedIndex="0" Padding="8" IsEnabled="{Binding IsChecked, ElementName=HasDue}" AutomationProperties.Name="提醒时间">
   <ComboBoxItem Content="截止时提醒"/><ComboBoxItem Content="提前 5 分钟"/><ComboBoxItem Content="提前 15 分钟"/><ComboBoxItem Content="提前 1 小时"/><ComboBoxItem Content="提前 1 天"/><ComboBoxItem Content="不提醒"/>
  </ComboBox>
  <TextBlock Text="应用运行时提醒；退出或关机期间错过的提醒，会在下次启动时补发。" TextWrapping="Wrap" Foreground="#7D877F" FontSize="11" Margin="0,12,0,0"/>
  <TextBlock x:Name="ErrorText" Foreground="#B2493B" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" IsCancel="True"/><Button Content="保存待办" IsDefault="True" Click="SaveClick" Background="#345B48" Foreground="White"/>
  </StackPanel>
 </StackPanel>
</Window>
